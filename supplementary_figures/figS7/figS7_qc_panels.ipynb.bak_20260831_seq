    "# §2 Helpers\n",
    "filter_high_na_genes <- function(mat, thr = 0.5) {\n",
    "  mat[rowMeans(is.na(mat)) < thr, , drop = FALSE]\n",
    "}\n",
    "\n",
    "quantile_normalize <- function(mat) {\n",
    "  nr <- nrow(mat); nc <- ncol(mat)\n",
    "  max_non_na <- max(colSums(!is.na(mat)))\n",
    "  sorted <- matrix(NA_real_, nrow = max_non_na, ncol = nc)\n",
    "  for (i in seq_len(nc)) {\n",
    "    v <- mat[, i]; v <- sort(v[!is.na(v)])\n",
    "    sorted[seq_along(v), i] <- v\n",
    "  }\n",
    "  rmean <- rowMeans(sorted, na.rm = TRUE)\n",
    "  out <- matrix(NA_real_, nrow = nr, ncol = nc, dimnames = dimnames(mat))\n",
    "  for (i in seq_len(nc)) {\n",
    "    v <- mat[, i]; na_idx <- is.na(v)\n",
    "    out[!na_idx, i] <- rmean[rank(v[!na_idx], ties.method = \"average\")]\n",
    "  }\n",
    "  out\n",
    "}\n",
    "\n",
    "impute_relaxed <- function(mat, k = 10) {\n",
    "  suppressWarnings(suppressMessages(\n",
    "    impute::impute.knn(mat, k = k, maxp = \"p\", rowmax = 0.95, colmax = 0.95)$data))\n",
    "}\n",
    "\n",
    "# Matches `perform_imputation` in the exploration notebook — uses impute.knn's\n",
    "# stricter defaults (rowmax=0.5, colmax=0.8) so the SVD/Harmony/UMAP\n",
    "# downstream agree with the exploration sweep figures.\n",
    "perform_imputation <- function(data_mat, k = 10) {\n",
    "  suppressWarnings(suppressMessages(\n",
    "    impute::impute.knn(data_mat, k = k, maxp = \"p\")$data))\n",
    "}\n",
    "\n",
    "svd_embedding <- function(mat_features_x_cells, n_comps = 20) {\n",
    "  data_t <- t(mat_features_x_cells)\n",
    "  sv <- svd(scale(data_t))\n",
    "  out <- sv$u[, seq_len(min(n_comps, ncol(sv$u))), drop = FALSE]\n",
    "  rownames(out) <- rownames(data_t)\n",
    "  attr(out, \"svd\") <- sv\n",
    "  out\n",
    "}\n",
    "\n",
    "build_knn_graph <- function(emb, n_pc, k) {\n",
    "  ng  <- min(n_pc, ncol(emb))\n",
    "  knn <- cccd::nng(emb[, seq_len(ng), drop = FALSE], k = k)\n",
    "  if (\"weight\" %in% igraph::edge_attr_names(knn))\n",
    "    knn <- igraph::delete_edge_attr(knn, \"weight\")\n",
    "  igraph::as.undirected(knn, mode = \"collapse\")\n",
    "}\n",
    "\n",
    "run_leiden <- function(emb, n_pc = 3, k = 25, resolution = 0.2) {\n",
    "  g   <- build_knn_graph(emb, n_pc, k)\n",
    "  com <- igraph::cluster_leiden(g, objective_function = \"modularity\",\n",
    "                                resolution_parameter = resolution, n_iterations = 5)\n",
    "  as.integer(igraph::membership(com))\n",
    "}\n",
    "\n",
    "partition_colors <- function(p, palette = brewer.pal(8, \"Dark2\")) {\n",
    "  col <- rep(palette[1], length(p))\n",
    "  for (i in unique(p)) col[p == i] <- palette[((i - 1) %% length(palette)) + 1]\n",
    "  col\n",
    "}\n",
    "\n",
    "make_umap_df <- function(layout, meta) {\n",
    "  as.data.frame(layout) %>% setNames(c(\"UMAP1\", \"UMAP2\")) %>%\n",
    "    tibble::rownames_to_column(\"cell\") %>% dplyr::left_join(meta, by = \"cell\")\n",
    "}\n",
    "\n",
    "# --- figure savers: write BOTH pdf + png (and render inline) ---\n",
    "# base graphics: `draw` is a no-arg function that renders the plot\n",
    "save_fig_both <- function(basepath, width, height, draw) {\n",
    "  pdf(paste0(basepath, \".pdf\"), width = width, height = height); draw(); dev.off()\n",
    "  png(paste0(basepath, \".png\"), width = width, height = height, units = \"in\", res = 150); draw(); dev.off()\n",
    "  invisible(NULL)\n",
    "}\n",
    "# ggplot objects\n",
    "ggsave_both <- function(basepath, plot, width, height) {\n",
    "  ggplot2::ggsave(paste0(basepath, \".pdf\"), plot, width = width, height = height)\n",
    "  ggplot2::ggsave(paste0(basepath, \".png\"), plot, width = width, height = height, dpi = 150)\n",
    "  invisible(NULL)\n",
    "}\n"
   ]
