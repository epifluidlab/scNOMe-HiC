   "source": [
    "options(repr.plot.width = 22, repr.plot.height = 10)\n",
    "# §4 QC / batch panels on the integrated UMAP.\n",
    "# Resume-friendly: load saved metadata / layouts if the in-session objects are absent.\n",
    "if (!exists(\"submetadata\"))\n",
    "  submetadata <- read.table(file.path(OUT_TAB, \"..\", \"annotation\", \"metadata_with_cell_type.txt\"),\n",
    "                            header = TRUE, sep = \"\\t\", row.names = 1, check.names = FALSE,\n",
    "                            quote = \"\", comment.char = \"\")\n",
    "if (!exists(\"joint_umap\"))\n",
    "  joint_umap <- list(layout = as.matrix(read.table(file.path(OUT_TAB, \"joint_umap.txt\"),\n",
    "                     header = TRUE, row.names = 1, check.names = FALSE)))\n",
    "if (!exists(\"joint_umap_uncorr\"))\n",
    "  joint_umap_uncorr <- list(layout = as.matrix(read.table(file.path(OUT_TAB, \"joint_umap_uncorrected.txt\"),\n",
    "                     header = TRUE, row.names = 1, check.names = FALSE)))\n",
    "\n",
    "# plate_ID / library_prep_date are columns of the saved metadata, merged there\n",
    "# from the two library sample sheets — nothing is read ad-hoc here.\n",
    "stopifnot(\"library_prep_date\" %in% colnames(submetadata))\n",
    "cat(\"library_prep_date coverage:\",\n",
    "    sum(!is.na(submetadata[rownames(joint_umap$layout), \"library_prep_date\"])),\n",
    "    \"/\", nrow(joint_umap$layout), \"\\n\")\n",
    "\n",
    "num <- function(x) as.numeric(as.character(x))\n",
    "build_qc_df <- function(layout) {\n",
    "  cells <- rownames(layout)\n",
    "  d <- data.frame(UMAP1 = layout[, 1], UMAP2 = layout[, 2], row.names = cells)\n",
    "  s <- submetadata[cells, \"sample\"]\n",
    "  d$replicate <- ifelse(s == \"scNH\", \"batch1\", ifelse(s == \"batch2\", \"batch2\", s))\n",
    "  d$Library_prep_date <- factor(submetadata[cells, \"library_prep_date\"])  # B\n",
    "  d$log10_uniq   <- log10(num(submetadata[cells, \"mapq30num\"]))  # C\n",
    "  d$pct_aligned  <- num(submetadata[cells, \"mapq30rate\"])        # D\n",
    "  d$incompl_conv <- num(submetadata[cells, \"noncpg_chrM\"])       # E (chrM non-CpG = incomplete conversion)\n",
    "  cisn <- num(submetadata[cells, \"cisnum\"]); trn <- num(submetadata[cells, \"transnum\"])\n",
    "  d$pct_cis <- 100 * cisn / (cisn + trn)                         # F\n",
    "  d\n",
    "}\n",
    "df_after  <- build_qc_df(joint_umap$layout)\n",
    "df_before <- build_qc_df(joint_umap_uncorr$layout)\n",
    "\n",
    "qc_theme <- theme_minimal(base_size = 15) +      # publication-size text\n",
    "  theme(legend.position = \"right\", axis.text = element_blank(),\n",
    "        panel.grid.minor = element_blank(),\n",
    "        plot.title   = element_text(size = 17, face = \"bold\"),\n",
    "        axis.title   = element_text(size = 15),\n",
    "        legend.text  = element_text(size = 12),\n",
    "        legend.title = element_text(size = 13),\n",
    "        legend.key.size = unit(0.5, \"lines\"))\n",
    "qc_cont <- function(d, col, title)\n",
    "  ggplot(d, aes(UMAP1, UMAP2, colour = .data[[col]])) +\n",
    "    geom_point(size = 0.9, alpha = 0.9) +\n",
    "    scale_color_viridis_c(name = \"\", na.value = \"grey85\") + ggtitle(title) + qc_theme\n",
    "qc_catp <- function(d, col, title, pal = NULL) {\n",
    "  g <- ggplot(d, aes(UMAP1, UMAP2, colour = .data[[col]])) +\n",
    "    geom_point(size = 0.9, alpha = 0.9) + ggtitle(title) + qc_theme\n",
    "  if (!is.null(pal)) g + scale_color_manual(values = pal, na.value = \"grey85\", name = \"\")\n",
    "  else            g + scale_color_viridis_d(na.value = \"grey85\", name = \"\")\n",
    "}\n",
    "rep_pal <- c(batch1 = \"#E64B35\", batch2 = \"#4DBBD5\")\n",
    "\n",
    "pA0 <- qc_catp(df_before, \"replicate\", \"A. Biological replicate (before correction)\", rep_pal)\n",
    "pA1 <- qc_catp(df_after,  \"replicate\", \"A. Biological replicate (after correction)\",  rep_pal)\n",
    "pB  <- qc_catp(df_after[!is.na(df_after$Library_prep_date), ], \"Library_prep_date\", \"B. Library-prep batch (date)\")  # drop NA-date cells\n",
    "pC  <- qc_cont(df_after,  \"log10_uniq\",   \"C. Uniquely aligned reads (log10)\")\n",
    "pD  <- qc_cont(df_after,  \"pct_aligned\",  \"D. % aligned reads (MAPQ30)\")\n",
    "pE  <- qc_cont(df_after,  \"incompl_conv\", \"E. Bisulfite incomplete conversion rate\")\n",
    "pF  <- qc_cont(df_after,  \"pct_cis\",      \"F. % cis reads\")\n",
    "\n",
    "qc_panel <- (pA0 | pA1 | pB | pC) / (pD | pE | pF | patchwork::plot_spacer())\n",
    "ggsave_both(file.path(OUT_FIG, \"joint_umap_qc_panels\"), qc_panel, 22, 10)\n",
    "qc_panel"
   ]
  }
