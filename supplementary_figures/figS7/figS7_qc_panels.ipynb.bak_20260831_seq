    "# §1 Setup\n",
    "Sys.setenv(RETICULATE_PYTHON = \"/projects/b1198/epifluidlab/yoshii/software/conda/envs/scnomehic/bin/python\")\n",
    "library(reticulate)\n",
    "use_python(Sys.getenv(\"RETICULATE_PYTHON\"), required = TRUE)\n",
    "\n",
    "suppressPackageStartupMessages({\n",
    "  library(umap); library(impute); library(igraph); library(cccd); library(Matrix)\n",
    "  library(rhdf5); library(RColorBrewer); library(harmony)\n",
    "  library(dplyr); library(tidyr); library(tibble); library(ggplot2); library(patchwork)\n",
    "})\n",
    "set.seed(42)\n",
    "\n",
    "WORKDIR <- \"/gpfs/projects/b1198/epifluidlab/yoshii/sc_nomehic/snakemake\"\n",
    "OUT_DIR <- file.path(WORKDIR, \"subset_clustering\", \"250kb_denovo\")\n",
    "OUT_TAB <- file.path(OUT_DIR, \"tables\")\n",
    "OUT_FIG <- file.path(OUT_DIR, \"figures\")\n",
    "ANN_DIR <- file.path(OUT_DIR, \"annotation\")\n",
    "for (d in c(OUT_TAB, OUT_FIG, ANN_DIR)) dir.create(d, recursive = TRUE, showWarnings = FALSE)\n",
    "setwd(WORKDIR); par(bg = \"white\")"
   ]
