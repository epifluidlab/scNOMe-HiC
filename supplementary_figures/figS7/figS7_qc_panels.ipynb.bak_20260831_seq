   "source": [
    "# §3 Uncorrected (pre-Harmony) joint embedding = the \"before batch correction\"\n",
    "# half of panel A. Same recipe as the corrected joint embedding, but on the RAW\n",
    "# per-modality SVD embeddings\n",
    "# (HCG top-9, Hi-C top-10, GCH top-20), with NO Harmony.\n",
    "# Resume-friendly: use the in-session SVD objects when this runs inside the Fig-3\n",
    "# notebook, otherwise read the saved tables (fig3_umap.ipynb §4a/§5a/§6b wrote\n",
    "# them). Standalone, the second path is always the one taken.\n",
    "rd_tab <- function(f) as.matrix(read.table(file.path(OUT_TAB, f), header = TRUE,\n",
    "                                           row.names = 1, check.names = FALSE))\n",
    "hcg_raw <- if (exists(\"HCG.svd\")) HCG.svd[, seq_len(9),  drop = FALSE] else rd_tab(\"hcg_svd_raw.txt\")\n",
    "hic_raw <- if (exists(\"hic_mat\")) hic_mat[, seq_len(10), drop = FALSE] else rd_tab(\"hic_svd_raw.txt\")\n",
    "gch_raw <- if (exists(\"gch_svd\")) gch_svd[, seq_len(20), drop = FALSE] else rd_tab(\"gch_svd_raw.txt\")\n",
    "\n",
    "shared_u <- Reduce(intersect, list(rownames(hcg_raw), rownames(hic_raw), rownames(gch_raw)))\n",
    "cat(\"Uncorrected joint cells:\", length(shared_u), \"\\n\")\n",
    "\n",
    "jc <- cbind(scale(hcg_raw[shared_u, , drop = FALSE]),\n",
    "            scale(hic_raw[shared_u, , drop = FALSE]),\n",
    "            scale(gch_raw[shared_u, , drop = FALSE]))\n",
    "jp <- prcomp(jc, center = FALSE, scale. = FALSE)$x            # decorrelating rotation\n",
    "\n",
    "ucfg <- umap::umap.defaults\n",
    "ucfg$n_neighbors  <- 10\n",
    "ucfg$min_dist     <- 0.2\n",
    "ucfg$metric       <- \"euclidean\"\n",
    "ucfg$random_state <- 42\n",
    "set.seed(42)\n",
    "joint_umap_uncorr <- umap::umap(jp, config = ucfg)\n",
    "rownames(joint_umap_uncorr$layout) <- shared_u\n",
    "write.table(joint_umap_uncorr$layout, file.path(OUT_TAB, \"joint_umap_uncorrected.txt\"),\n",
    "            sep = \"\\t\", quote = FALSE)\n",
    "cat(\"uncorrected joint UMAP:\", dim(joint_umap_uncorr$layout), \"\\n\")"
   ]
