    "\n",
    "ct_tbl <- data.frame(\n",
    "  cell = rownames(submetadata)[labeled],\n",
    "  cell_type = submetadata$cell_type[labeled],\n",
    "  stringsAsFactors = FALSE\n",
    ")\n",
    "write.table(ct_tbl, file.path(ANN_DIR, \"cell_type_table.tsv\"),\n",
    "            sep = \"\\t\", quote = FALSE, row.names = FALSE)\n",
    "\n",
    "# Column layout mirrors subset_clustering/250kb/annotation/metadata_with_cell_type.txt:\n",
    "# the QC/base block first, then the annotation block, then plate_ID and\n",
    "# library_prep_date LAST. cell_type_prior (the earlier annotation, kept only for a\n",
    "# concordance check that is not part of this notebook) is dropped -- it must not\n",
    "# ship in the released file.\n",
    "# The old file's cell_type_original / cell_type_nn / cell_type_preCorrect have no\n",
    "# de novo analogue: there is no k-NN imputation and no manual correction step.\n",
    "# leiden_cluster (the plain single-seed Leiden cluster) replaces them. There is\n",
    "# no rescued flag: plain Leiden assigns every cell, so nothing is rescued.\n",
    ".meta_out <- submetadata\n",
