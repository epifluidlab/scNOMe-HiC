    ".tail <- c(\"plate_ID\", \"library_prep_date\")\n",
    ".ann  <- c(\"cell_type\", \"cluster_color\", \"cell_type_fct\", \"leiden_cluster\")\n",
    ".base <- setdiff(colnames(.meta_out), c(.ann, .tail))\n",
    ".meta_out <- .meta_out[, c(.base, intersect(.ann, colnames(.meta_out)),\n",
