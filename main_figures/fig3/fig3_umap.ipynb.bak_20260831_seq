    "# \u00a78.5c Marker-gene GCH accessibility heatmaps \u2014 NORMALISED (mean-sub + z-score + clip)\n",
    "# Proper marker-heatmap normalization, in three steps:\n",
    "#   1. mean-subtract: from each marker value subtract that cell type's READ-WEIGHTED\n",
    "#      global rate G[ct] = sum(accessible over ALL genes)/sum(cov). Removes the\n",
    "#      per-cell-type global offset (else globally-high types like IT-L4 / PC-EC read\n",
    "#      red across nearly all markers). This is the pooled-level analogue of ALLCools'\n",
    "#      per-cell global-rate normalization, consistent with read-weighted pooling.\n",
    "#   2. z-score per GENE (column): standardises each gene so its winning cell type is\n",
    "#      red regardless of the gene's absolute accessibility. Without this, a gene that\n",
    "#      is globally low (e.g. Foxp2) looks blue everywhere even where its own type wins.\n",
    "#   3. CLIP at +-ZCLIP: a few outlier cells (z up to ~2.8) otherwise stretch the colour\n",
    "#      scale and wash everything out; clipping lets typical cells use the full range.\n",
    "# (This is essentially what Seurat's DoHeatmap does: scaled + clipped.) Saved under a\n",
    "# distinct name (..._ctmeansub) so the raw \u00a78.5b heatmaps are preserved for compare.\n",
    "suppressPackageStartupMessages({ library(pheatmap); library(grid) })\n",
    "stopifnot(exists(\"ct_order\"), exists(\"celltype_colors\"),\n",
    "          exists(\"marker_lists_gch\"), exists(\"REGIONS_GCH\"), exists(\"GCH_COUNTS_DIR\"))\n",
    "\n",
    "ZCLIP <- 2   # clip z-scores to +-ZCLIP so a few outliers don't wash out the colour scale\n",
    "\n",
    "# read-weighted pseudobulk, mean-subtracted, then z-scored per gene and clipped\n",
    "pseudobulk_gch_sub <- function(region) {\n",
    "  obj <- readRDS(file.path(GCH_COUNTS_DIR, sprintf(\"GCH_%s_counts.rds\", region)))\n",
    "  mc <- obj$mc; cov <- obj$cov\n",
    "  present <- intersect(unlist(marker_lists_gch), rownames(mc))\n",
    "  ml  <- lapply(marker_lists_gch, intersect, y = present); mg <- unlist(ml)\n",
    "  labeled <- intersect(colnames(mc),\n",
    "                       rownames(submetadata)[!is.na(submetadata$cell_type)])\n",
    "  grp <- split(labeled, submetadata[labeled, \"cell_type\"])\n",
    "  pb  <- t(sapply(grp, function(cc) {\n",
    "    num <- rowSums(mc [mg, cc, drop = FALSE])\n",
    "    den <- rowSums(cov[mg, cc, drop = FALSE])\n",
    "    v <- num / den; v[den == 0] <- NA_real_; v\n",
    "  }))\n",
    "  G   <- sapply(grp, function(cc) sum(mc[, cc]) / sum(cov[, cc]))   # global rate (ALL genes), per type\n",
    "  ctp <- intersect(ct_order, rownames(pb))\n",
    "  resid <- sweep(pb[ctp, mg, drop = FALSE], 1, G[ctp], \"-\")         # 1) mean-subtract\n",
    "  z <- scale(resid)                                                 # 2) z-score per gene (column)\n",
    "  z[is.nan(z)] <- 0                                                 # constant gene -> 0\n",
    "  z <- pmax(pmin(z, ZCLIP), -ZCLIP)                                 # 3) clip\n",
    "  dimnames(z) <- dimnames(resid)\n",
    "  list(mat = z, resid = resid, ml = ml, mg = mg, ctp = ctp, G = G[ctp])\n",
    "}\n",
    "\n",
    "build_gch_sub_heat <- function(region, label) {\n",
    "  r   <- pseudobulk_gch_sub(region)\n",
    "  g2t <- rep(names(r$ml), lengths(r$ml)); names(g2t) <- r$mg\n",
    "  ann_col <- data.frame(CellType = factor(g2t[r$mg], levels = names(marker_lists_gch)),\n",
    "                        row.names = r$mg)\n",
    "  ann_row <- data.frame(CellType = factor(r$ctp, levels = names(marker_lists_gch)),\n",
    "                        row.names = r$ctp)\n",
    "  ann_colors <- list(CellType = celltype_colors[levels(ann_col$CellType)])\n",
    "  # Lineage groups for the row dividers. Must list ALL excitatory types, or the\n",
    "  # Exc | Inh | Non-neuron gaps land on the wrong rows.\n",
    "  exc <- c(\"IT-L2/3\",\"IT-L4\",\"IT-L5/6\",\"CT-L6\"); inh <- \"Inhib\"\n",
    "  gaps_row <- c(sum(r$ctp %in% exc), sum(r$ctp %in% c(exc, inh)))\n",
    "  gaps_col <- cumsum(lengths(r$ml))[seq_len(length(r$ml) - 1)]\n",
    "  args <- list(\n",
    "    mat = r$mat, cluster_rows = FALSE, cluster_cols = FALSE,\n",
    "    annotation_col = ann_col, annotation_row = ann_row,\n",
    "    annotation_colors = ann_colors, gaps_row = gaps_row, gaps_col = gaps_col,\n",
    "    scale = \"none\", breaks = seq(-ZCLIP, ZCLIP, length.out = 51),\n",
    "    color = colorRampPalette(c(\"#3b4cc0\",\"white\",\"#b40426\"))(50),\n",
    "    main = sprintf(\"Cortex marker GCH accessibility (%s, mean-sub + z-score, clip +-%g)\", label, ZCLIP))\n",
    "  c(r, list(args = args,\n",
    "            out_pdf = file.path(OUT_FIG, sprintf(\"marker_gene_heatmap_GCH_%s_ctmeansub.pdf\", region))))\n",
    "}\n",
    "\n",
    "options(repr.plot.width = 11, repr.plot.height = 6)\n",
    "gch_marker_pb_sub <- list()\n",
    "for (region in names(REGIONS_GCH))\n",
    "  gch_marker_pb_sub[[region]] <- build_gch_sub_heat(region, REGIONS_GCH[[region]])\n",
    "\n",
    "# inline render FIRST \u2014 pheatmap(filename=) below closes its own device and\n",
    "# disables inline display for the rest of the cell, so draw to the notebook first\n",
    "for (region in names(REGIONS_GCH)) print(do.call(pheatmap, gch_marker_pb_sub[[region]]$args))\n",
    "\n",
    "for (region in names(REGIONS_GCH)) {\n",
    "  a <- gch_marker_pb_sub[[region]]\n",
    "  for (ext in c(\"pdf\", \"png\"))\n",
    "    do.call(pheatmap, c(a$args, list(filename = sub(\"\\\\.pdf$\", paste0(\".\", ext), a$out_pdf),\n",
    "                                    width = 11, height = 6)))\n",
    "  cat(sprintf(\"wrote %s (+png)  (%d cell types x %d markers)\\n\",\n",
    "              basename(a$out_pdf), nrow(a$args$mat), ncol(a$args$mat)))\n",
    "}\n"
   ]
  },
