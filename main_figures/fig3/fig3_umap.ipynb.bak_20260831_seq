    "# \u00a74a HCG: load + impute + SVD\n",
    "hcg_path <- file.path(WORKDIR, \"QC\", \"methylation_matrices\", \"methylation_matrix_HCG_250kb.tsv.gz\")\n",
    "hcg_mat <- read.table(gzfile(hcg_path), header = TRUE, sep = \"\\t\",\n",
    "                      row.names = 1, check.names = FALSE,\n",
    "                      na.strings = c(\"NA\", \"\", \"NaN\"))\n",
    "hcg_mat <- data.matrix(hcg_mat)\n",
    "common  <- intersect(rownames(hcg_mat), submetadata$name)\n",
    "hcg_mat <- hcg_mat[common, , drop = FALSE]\n",
    "hcg_mat <- hcg_mat[, colSums(is.na(hcg_mat)) < 0.8 * nrow(hcg_mat), drop = FALSE]\n",
    "cat(\"HCG (cells x bins) after filter:\", dim(hcg_mat), \"\\n\")\n",
    "\n",
    "# impute.knn draws on the RNG, so the seed is what makes the SVD -- and\n",
    "# therefore Harmony, the Leiden partition and the labels -- reproducible.\n",
    "set.seed(42)\n",
    "hcg_imputed <- impute_relaxed(hcg_mat, k = 10)\n",
    "rownames(hcg_imputed) <- rownames(hcg_mat); colnames(hcg_imputed) <- colnames(hcg_mat)\n",
    "\n",
    "HCG.svd_full <- svd(scale(hcg_imputed))\n",
    "HCG.svd      <- HCG.svd_full$u\n",
    "rownames(HCG.svd) <- rownames(hcg_imputed)\n",
    "cat(\"HCG SVD:\", dim(HCG.svd), \"\\n\")\n",
    "\n",
    "# save pre-Harmony SVD (top-9) for the \u00a78.7c before-correction joint UMAP\n",
    "write.table(HCG.svd[, seq_len(9)], file.path(OUT_TAB, \"hcg_svd_raw.txt\"), sep = \"\\t\", quote = FALSE)\n"
   ]
  },
