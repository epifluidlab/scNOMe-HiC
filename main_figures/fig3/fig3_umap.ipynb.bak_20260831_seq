   "source": [
    "# \u00a78.5 Marker-gene HCG methylation heatmaps \u2014 read-weighted pseudobulk\n",
    "# Source: per-cell HCG methylated_reads / total_reads at three region\n",
    "# resolutions (this replaced an earlier dependence on a precomputed matrix),\n",
    "# precomputed by QC/methylation_matrices/build_hcg_counts.R into\n",
    "#   HCG_<region>_counts.rds   (list of mc, cov : genes x cells).\n",
    "# Pseudobulk per cell type is READ-WEIGHTED: sum(mc)/sum(cov) over the cells\n",
    "# in that type (not a mean of per-cell fractions), so high-coverage cells\n",
    "# contribute proportionally and no kNN imputation is needed.\n",
    "suppressPackageStartupMessages({ library(pheatmap); library(grid) })\n",
    "\n",
    "COUNTS_DIR <- file.path(WORKDIR, \"QC\", \"methylation_matrices\")\n",
    "# region key -> label for titles/filenames\n",
    "REGIONS <- c(gene = \"TSS+gene body\")   # TSS+gene body only, per the figure spec;\n",
    "# HCG_gene_counts.rds / GCH_gene_counts.rds pool reads over the TSS and the\n",
    "# gene body together. The TSS-only and body-only variants are still built by\n",
    "# build_{hcg,gch}_counts.R and saved by \u00a79b; they are simply not plotted.\n",
    "\n",
    "## Marker panel comes from \u00a78e: the PUBLISHED markers of Liu et al. 2021\n",
    "## Supplementary Table 7, one block per cell type. Nothing in the gene list was\n",
    "## chosen using these data, so the panel is not circular. Expect it to be uneven:\n",
    "## the glial and vascular blocks reproduce strongly, IT-L2/3 and IT-L5/6 largely\n",
    "## do not -- a property of the reference list, quantified in \u00a78e's tally.\n",
    "stopifnot(exists(\"marker_lists\"), exists(\"ct_order\"), length(ct_order) == 10)\n",
    "\n",
    "# read-weighted pseudobulk (cell_type x marker_gene) for one region\n",
    "pseudobulk_region <- function(region) {\n",
    "  obj <- readRDS(file.path(COUNTS_DIR, sprintf(\"HCG_%s_counts.rds\", region)))\n",
    "  mc <- obj$mc; cov <- obj$cov                          # genes x cells\n",
    "  present <- intersect(unlist(marker_lists), rownames(mc))\n",
    "  ml  <- lapply(marker_lists, intersect, y = present)   # keep only present markers\n",
    "  mg  <- unlist(ml)\n",
    "  labeled <- intersect(colnames(mc),\n",
    "                       rownames(submetadata)[!is.na(submetadata$cell_type)])\n",
    "  grp <- split(labeled, submetadata[labeled, \"cell_type\"])\n",
    "  # Global gene-body HCG differs by cell type by ~7 percentage points on this\n",
    "  # annotation (Inhib 0.742 highest, PC/EC 0.671 lowest; neurons above glia).\n",
    "  # Subtract each type's own global rate, matching how \u00a78e scores the same genes\n",
    "  # -- otherwise the table and the figure use different estimators.\n",
    "  # scale = \"column\" does NOT fix this: per-gene centring shifts a gene by a\n",
    "  # constant and leaves the per-cell-type offset untouched. Uncorrected, a\n",
    "  # globally-hypomethylated type reads as marker-positive everywhere.\n",
    "  glob <- sapply(grp, function(cc)\n",
    "    sum(mc[, cc, drop = FALSE]) / sum(cov[, cc, drop = FALSE]))\n",
    "  pb  <- t(sapply(grp, function(cc) {\n",
    "    num <- rowSums(mc [mg, cc, drop = FALSE])\n",
    "    den <- rowSums(cov[mg, cc, drop = FALSE])\n",
    "    v <- num / den; v[den == 0] <- NA_real_; v\n",
    "  }))                                                    # cell_type x marker_gene\n",
    "  pb <- sweep(pb, 1, glob[rownames(pb)], \"-\")            # per-type mean subtraction\n",
    "  ctp <- intersect(ct_order, rownames(pb))\n",
    "  list(mat = pb[ctp, mg, drop = FALSE], ml = ml, mg = mg, ctp = ctp)\n",
    "}\n",
    "\n",
    "# Build the pseudobulk matrix + pheatmap argument list for one region (no plotting).\n",
    "build_region_heat <- function(region, label) {\n",
    "  r   <- pseudobulk_region(region)\n",
    "  g2t <- rep(names(r$ml), lengths(r$ml)); names(g2t) <- r$mg\n",
    "  ann_col <- data.frame(CellType = factor(g2t[r$mg], levels = names(marker_lists)),\n",
    "                        row.names = r$mg)\n",
    "  ann_row <- data.frame(CellType = factor(r$ctp, levels = names(marker_lists)),\n",
    "                        row.names = r$ctp)\n",
    "  ann_colors <- list(CellType = celltype_colors[levels(ann_col$CellType)])\n",
    "  # Lineage groups for the row dividers. Must list ALL excitatory types, or the\n",
    "  # Exc | Inh | Non-neuron gaps land on the wrong rows.\n",
    "  exc <- c(\"IT-L2/3\",\"IT-L4\",\"IT-L5/6\",\"CT-L6\"); inh <- \"Inhib\"\n",
    "  gaps_row <- c(sum(r$ctp %in% exc), sum(r$ctp %in% c(exc, inh)))\n",
    "  gaps_col <- cumsum(lengths(r$ml))[seq_len(length(r$ml) - 1)]\n",
    "  args <- list(\n",
    "    mat = r$mat, cluster_rows = FALSE, cluster_cols = FALSE,\n",
    "    annotation_col = ann_col, annotation_row = ann_row,\n",
    "    annotation_colors = ann_colors, gaps_row = gaps_row, gaps_col = gaps_col,\n",
    "    scale = \"column\", color = colorRampPalette(c(\"#3b4cc0\",\"white\",\"#b40426\"))(50),\n",
    "    main = sprintf(\"Cortex marker HCG methylation (%s, read-weighted, global rate subtracted)\", label))\n",
    "  c(r, list(args = args,\n",
    "            out_pdf = file.path(OUT_FIG, sprintf(\"marker_gene_heatmap_HCG_%s.pdf\", region))))\n",
    "}\n",
    "\n",
    "options(repr.plot.width = 11, repr.plot.height = 6)\n",
    "\n",
    "# 1) Build pseudobulk + heatmap args for every region (no plotting yet).\n",
    "hcg_marker_pb <- list()\n",
    "for (region in names(REGIONS))\n",
    "  hcg_marker_pb[[region]] <- build_region_heat(region, REGIONS[[region]])\n",
    "\n",
    "# 2) Inline render for the notebook FIRST. pheatmap with no filename draws to the\n",
    "#    current device. This MUST run BEFORE the filename= writes below: writing a file\n",
    "#    opens AND closes pheatmap's own graphics device, which disables inline display\n",
    "#    for the rest of the cell. So draw to the notebook first, then write the files.\n",
    "for (region in names(REGIONS)) print(do.call(pheatmap, hcg_marker_pb[[region]]$args))\n",
    "\n",
    "# 3) Write each PDF + PNG via pheatmap's own `filename=` argument. pheatmap opens\n",
    "#    AND closes its own graphics device internally and correctly, so the write is\n",
    "#    robust even if other graphics devices are open in the session (e.g. a stale\n",
    "#    device left by an earlier crashed run). Hand-rolled pdf()/dev.off() around\n",
    "#    pheatmap is fragile here \u2014 that produced the earlier truncated gene_tss.pdf.\n",
    "for (region in names(REGIONS)) {\n",
    "  a <- hcg_marker_pb[[region]]\n",
    "  for (ext in c(\"pdf\", \"png\"))\n",
    "    do.call(pheatmap, c(a$args, list(filename = sub(\"\\\\.pdf$\", paste0(\".\", ext), a$out_pdf), width = 11, height = 6)))\n",
    "  cat(sprintf(\"wrote %s (+png)  (%d cell types x %d markers)\\n\",\n",
    "              basename(a$out_pdf), nrow(a$args$mat), ncol(a$args$mat)))\n",
    "}\n"
   ]
