   "source": [
    "# \u00a79b Per-cell-type pseudobulk matrices (HCG + GCH, three region definitions).\n",
    "# READ-WEIGHTED, matching every other analysis here:\n",
    "#     rate[type, gene] = sum(mc over that type's cells) / sum(cov over them)\n",
    "# NOT mean(mc/cov) across cells -- a per-cell mean would weight a 3-read cell the\n",
    "# same as a 300-read cell. On this data the two differ by up to 0.067 (e.g. Pvalb\n",
    "# at the Pvalb locus: 0.307 read-weighted vs 0.374 as a mean of rates).\n",
    "suppressPackageStartupMessages(library(Matrix))\n",
    "CNT <- file.path(WORKDIR, \"QC\", \"methylation_matrices\")\n",
    "OUT <- file.path(OUT_DIR, \"pseudobulk\"); dir.create(OUT, showWarnings = FALSE)\n",
    "LEV <- cell_type_levels\n",
    "meta <- submetadata\n",
    "REGIONS   <- c(\"gene_tss\", \"gene_body\", \"gene\")\n",
    "MODALITIES <- c(HCG = \"HCG\", GCH = \"GCH\")\n",
    "\n",
    "# RUN-ONCE CACHE. This step reads six large per-cell count matrices and takes a\n",
    "# few minutes. Set RECOMPUTE_PSEUDOBULK <- FALSE to skip it and load the saved\n",
    "# matrices instead.\n",
    "#\n",
    "# The cache is keyed on the ANNOTATION, not just on the files existing: the\n",
    "# stored pseudobulk carries the cell-type composition it was built from, and if\n",
    "# that no longer matches submetadata the cache is rejected and recomputed. So\n",
    "# re-running \u00a78a with different parameters can never leave a stale pseudobulk\n",
    "# silently in place.\n",
    "RECOMPUTE_PSEUDOBULK <- TRUE\n",
    "\n",
    ".stamp_file <- file.path(OUT, \"pseudobulk_annotation_stamp.txt\")\n",
    ".stamp_now  <- paste(sprintf(\"%s:%d\", LEV[LEV %in% unique(meta$cell_type)],\n",
    "                             as.integer(table(meta$cell_type)[\n",
    "                               LEV[LEV %in% unique(meta$cell_type)]])), collapse = \"|\")\n",
    ".cache_ok <- file.exists(.stamp_file) &&\n",
    "             identical(readLines(.stamp_file, warn = FALSE)[1], .stamp_now) &&\n",
    "             all(file.exists(file.path(OUT, sprintf(\"pseudobulk_%s_%s_rate.csv.gz\",\n",
    "                 rep(names(MODALITIES), each = length(REGIONS)), REGIONS))))\n",
    "\n",
    "if (!RECOMPUTE_PSEUDOBULK && .cache_ok) {\n",
    "  cat(\"using cached pseudobulk (annotation stamp matches)\\n\")\n",
    "  cat(\"  \", .stamp_now, \"\\n\")\n",
    "  pseudobulk <- lapply(setNames(nm = as.vector(outer(names(MODALITIES), REGIONS,\n",
    "                                                     paste, sep = \"_\"))),\n",
    "    function(tag) as.matrix(read.csv(gzfile(file.path(OUT,\n",
    "      sprintf(\"pseudobulk_%s_rate.csv.gz\", tag))), row.names = 1, check.names = FALSE)))\n",
    "  cat(sprintf(\"  loaded %d matrices, %d cell types\\n\",\n",
    "              length(pseudobulk), nrow(pseudobulk[[1]])))\n",
    "} else {\n",
    "  if (!RECOMPUTE_PSEUDOBULK && !.cache_ok)\n",
    "    cat(\"cache MISSING or built from a different annotation - recomputing\\n\")\n",
    "\n",
    "summary_rows <- list()\n",
    "for (mod in names(MODALITIES)) {\n",
    "  for (reg in REGIONS) {\n",
    "    f <- file.path(CNT, sprintf(\"%s_%s_counts.rds\", MODALITIES[[mod]], reg))\n",
    "    if (!file.exists(f)) { cat(\"  missing:\", basename(f), \"- skipped\\n\"); next }\n",
    "    obj <- readRDS(f)\n",
    "    cells <- intersect(rownames(meta), colnames(obj$mc))\n",
    "    grp   <- setNames(meta[cells, \"cell_type\"], cells)\n",
    "    types <- LEV[LEV %in% unique(grp)]\n",
    "\n",
    "    # READ-WEIGHTED: sum(mc) / sum(cov) over the cells of each type\n",
    "    MC <- sapply(types, function(t) Matrix::rowSums(obj$mc [, names(grp)[grp == t], drop = FALSE]))\n",
    "    CV <- sapply(types, function(t) Matrix::rowSums(obj$cov[, names(grp)[grp == t], drop = FALSE]))\n",
    "    RATE <- ifelse(CV > 0, MC / CV, NA_real_)\n",
    "    dimnames(RATE) <- dimnames(MC) <- dimnames(CV) <- list(rownames(obj$mc), types)\n",
    "\n",
    "    tag <- sprintf(\"%s_%s\", mod, reg)\n",
    "    write.csv(round(t(RATE), 6), gzfile(file.path(OUT, sprintf(\"pseudobulk_%s_rate.csv.gz\", tag))))\n",
    "    write.csv(t(MC), gzfile(file.path(OUT, sprintf(\"pseudobulk_%s_mc.csv.gz\", tag))))\n",
    "    write.csv(t(CV), gzfile(file.path(OUT, sprintf(\"pseudobulk_%s_cov.csv.gz\", tag))))\n",
    "\n",
    "    gcov <- colSums(CV); gmc <- colSums(MC)\n",
    "    summary_rows[[tag]] <- data.frame(\n",
    "      modality = mod, region = reg, cell_type = types,\n",
    "      n_cells = as.integer(table(grp)[types]),\n",
    "      total_cov = as.numeric(gcov[types]),\n",
    "      global_rate = round(as.numeric(gmc[types] / gcov[types]), 4),\n",
    "      genes_with_cov = as.integer(colSums(CV > 0)[types]),\n",
    "      genes_cov_ge100 = as.integer(colSums(CV >= 100)[types]))\n",
    "    cat(sprintf(\"%-14s %d genes x %d types written\\n\", tag, nrow(RATE), ncol(RATE)))\n",
    "    rm(obj, MC, CV, RATE); invisible(gc(verbose = FALSE))\n",
    "  }\n",
    "}\n",
    "S <- do.call(rbind, summary_rows)\n",
    "write.csv(S, file.path(OUT, \"pseudobulk_summary.csv\"), row.names = FALSE)\n",
    "\n",
    "cat(\"\\n--- per-type coverage, HCG gene_body (the panel used for heatmaps) ---\\n\")\n",
    "hb <- S[S$modality == \"HCG\" & S$region == \"gene_body\", ]\n",
    "print(hb[order(-hb$n_cells), c(\"cell_type\",\"n_cells\",\"total_cov\",\"global_rate\",\n",
    "                               \"genes_cov_ge100\")], row.names = FALSE)\n",
    "cat(\"\\n--- global HCG rate by type (neurons should exceed glia) ---\\n\")\n",
    "cat(paste(sprintf(\"  %-8s %.3f\", hb$cell_type, hb$global_rate), collapse = \"\\n\"), \"\\n\")\n",
    "\n",
    "cat(\"\\nwrote per-cell-type pseudobulk to\", OUT, \"\\n\")\n",
    "\n",
    "writeLines(.stamp_now, .stamp_file)   # records the annotation this cache belongs to\n",
    "}\n"
   ]
