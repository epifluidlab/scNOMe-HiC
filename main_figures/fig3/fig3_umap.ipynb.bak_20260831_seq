   "source": [
    "options(repr.plot.width = 16, repr.plot.height = 4.6)\n",
    "# \u00a78.8 Four-panel per-modality UMAPs (Chen et al. 2026 Fig. 4b style)\n",
    "# HCG / GCH / HiC / Joint. cell_type carried only in the legend (no overlaid\n",
    "# text), axis tick values hidden, panels rendered side-by-side.\n",
    "stopifnot(\"cell_type\" %in% colnames(submetadata),\n",
    "          exists(\"HCG.umap\"), exists(\"gch_umap\"), exists(\"hic_umap\"),\n",
    "          exists(\"joint_umap\"))\n",
    "\n",
    "if (!exists(\"PUB_BASE\")) PUB_BASE <- 16\n",
    "# Resolve a font that the active PDF device can actually render. ggplot/grid\n",
    "# uses the PDF \"Helvetica\" family by default, so we leave element_text $family\n",
    "# unset (NULL -> inherit) below. This avoids the \"invalid font type\" error\n",
    "# that arises when PUB_FONT is set to a family not registered in the device\n",
    "# (e.g., a leftover \"Arial\" from a previous notebook run).\n",
    "PUB_FONT <- NULL  # force-clear any stale value left over from earlier runs\n",
    "\n",
    "build_modality_df <- function(layout_mat, modality) {\n",
    "  cells <- intersect(rownames(layout_mat), rownames(submetadata))\n",
    "  data.frame(cell      = cells,\n",
    "             UMAP1     = layout_mat[cells, 1],\n",
    "             UMAP2     = layout_mat[cells, 2],\n",
    "             cell_type = factor(submetadata[cells, \"cell_type\"],\n",
    "                                levels = names(celltype_colors)),\n",
    "             modality  = modality,\n",
    "             stringsAsFactors = FALSE)\n",
    "}\n",
    "panels <- list(\n",
    "  HCG   = build_modality_df(HCG.umap$layout,   \"HCG methylation\"),\n",
    "  GCH   = build_modality_df(gch_umap$layout,   \"GCH accessibility\"),\n",
    "  HiC   = build_modality_df(hic_umap$layout,   \"3D Genome\"),\n",
    "  JOINT = build_modality_df(joint_umap$layout, \"Joint embedding\")\n",
    ")\n",
    "panel_levels <- vapply(panels, function(p) p$modality[1], character(1))\n",
    "df_all <- do.call(rbind, panels)\n",
    "df_all$modality <- factor(df_all$modality, levels = panel_levels)\n",
    "df_all <- df_all[!is.na(df_all$cell_type), ]\n",
    "\n",
    "fig4b_theme <- theme(\n",
    "  panel.background = element_blank(), panel.grid = element_blank(),\n",
    "  panel.border     = element_rect(colour = \"black\", fill = NA, linewidth = 0.6),\n",
    "  axis.text        = element_blank(),\n",
    "  axis.ticks       = element_blank(),\n",
    "  axis.title       = element_text(size = PUB_BASE + 2),\n",
    "  strip.background = element_blank(),\n",
    "  strip.text       = element_text(size = PUB_BASE + 3, face = \"bold\"),\n",
    "  legend.title     = element_text(size = PUB_BASE + 3, face = \"bold\"),\n",
    "  legend.text      = element_text(size = PUB_BASE + 1),\n",
    "  legend.key       = element_rect(fill = \"white\"),\n",
    "  legend.position  = \"right\",\n",
    "  panel.spacing.x  = unit(0, \"lines\"),\n",
    "  plot.margin      = ggplot2::margin(8, 8, 8, 8)  # namespace-qualified: \u00a78c attaches\n",
    "                                                  # randomForest, whose margin() generic\n",
    "                                                  # masks ggplot2::margin and errors with\n",
    "                                                  # \"8 is not a factor\"\n",
    ")\n",
    "\n",
    "p_fig4b <- ggplot(df_all, aes(UMAP1, UMAP2, colour = cell_type)) +\n",
    "  geom_point(size = 1.7, alpha = 0.9, stroke = 0) +\n",
    "  scale_color_manual(values = celltype_colors, name = \"Cell type\", na.value = \"grey80\") +\n",
    "  facet_wrap(~ modality, nrow = 1, scales = \"free\") +\n",
    "  labs(x = \"UMAP 1\", y = \"UMAP 2\") +\n",
    "  fig4b_theme +\n",
    "  guides(colour = guide_legend(override.aes = list(size = 4, alpha = 1)))\n",
    "\n",
    "ggsave_both(file.path(OUT_FIG, \"umap_fig4b_style\"), p_fig4b, 16, 4.6)\n",
    "cat(\"wrote figures/umap_fig4b_style.pdf (4 panels incl. joint)\\n\")\n",
    "p_fig4b\n"
   ]
