    "\n",
    "PBDIR <- file.path(OUT_DIR, \"cemba_ref\", \"isocortex_pseudobulk\")\n",
    "atlas <- read.csv(file.path(PBDIR, \"cemba_isocortex_majortype_gene_mCG.csv.gz\"),\n",
    "                  row.names = 1, check.names = FALSE)\n",
    "ncell <- read.csv(file.path(PBDIR, \"cemba_isocortex_majortype_ncells.csv\"))\n",
    "atlas <- atlas[rownames(atlas) %in% ncell$MajorType[ncell$n_cells >= MIN_ATLAS_CELLS], ]\n",
    "\n",
    ".cnt  <- readRDS(file.path(WORKDIR, \"QC\", \"methylation_matrices\",\n",
    "                           \"HCG_gene_body_counts.rds\"))\n",
    "cells <- intersect(rownames(submetadata), colnames(.cnt$mc))\n",
    "grp   <- setNames(submetadata[cells, \"leiden_cluster\"], cells)\n",
    "gs    <- sort(unique(grp))\n",
    "mc <- sapply(gs, function(g) rowSums(.cnt$mc [, names(grp)[grp == g], drop = FALSE]))\n",
    "cv <- sapply(gs, function(g) rowSums(.cnt$cov[, names(grp)[grp == g], drop = FALSE]))\n",
    "ours <- t(ifelse(cv >= MIN_COV, mc / cv, NA))\n",
    "rm(.cnt); invisible(gc(verbose = FALSE))\n",
    "\n",
    "shared <- intersect(colnames(ours), colnames(atlas))\n",
    "Amat <- as.matrix(atlas[, shared, drop = FALSE]); Omat <- ours[, shared, drop = FALSE]\n",
    "keep <- colSums(is.na(Amat)) == 0 & colSums(is.na(Omat)) == 0\n",
    "Amat <- Amat[, keep, drop = FALSE]; Omat <- Omat[, keep, drop = FALSE]\n",
    "hvg  <- names(sort(apply(Amat, 2, var), decreasing = TRUE))[seq_len(min(N_HVG, ncol(Amat)))]\n",
    "cat(sprintf(\"atlas candidates: %d | genes usable in both: %d | correlating on %d\\n\",\n",
    "            nrow(Amat), ncol(Amat), length(hvg)))\n",
    "ctr <- function(M) sweep(M, 2, colMeans(M, na.rm = TRUE), \"-\")\n",
    "Ccor <- cor(t(ctr(Omat[, hvg, drop = FALSE])), t(ctr(Amat[, hvg, drop = FALSE])),\n",
    "            method = \"spearman\")\n",
    "\n",
    "# atlas major type -> manuscript label. NP-L6 folds into CT-L6 (its nearest\n",
    "# atlas neighbour, r = 0.373) and the four inhibitory subclasses fold into the\n",
    "# single merged group -- both are consequences of the resolution, not extra\n",
    "# hand-merges: no cluster is assigned NP-L6 or a second inhibitory type here.\n",
    "RENAME <- c(`IT-L23`=\"IT-L2/3\", `IT-L4`=\"IT-L4\", `IT-L5`=\"IT-L5/6\",\n",
    "            `IT-L6`=\"IT-L5/6\", `CT-L6`=\"CT-L6\", `NP-L6`=\"CT-L6\",\n",
    "            `MGE-Pvalb`=\"Inhib\", `MGE-Sst`=\"Inhib\", `CGE-Vip`=\"Inhib\",\n",
    "            `CGE-Lamp5`=\"Inhib\", ODC=\"ODC\", OPC=\"OPC\", ASC=\"ASC\", MGC=\"MGC\",\n",
    "            PC=\"PC/EC\", EC=\"PC/EC\")\n",
    "atlas_call <- data.frame(\n",
    "  cluster   = rownames(Ccor),\n",
    "  n         = as.integer(table(grp)[rownames(Ccor)]),\n",
    "  best      = colnames(Ccor)[apply(Ccor, 1, which.max)],\n",
    "  r         = round(apply(Ccor, 1, max), 3),\n",
    "  runner_up = colnames(Ccor)[apply(Ccor, 1, function(x) order(x, decreasing = TRUE)[2])],\n",
    "  r2        = round(apply(Ccor, 1, function(x) sort(x, decreasing = TRUE)[2]), 3),\n",
    "  stringsAsFactors = FALSE)\n",
    "atlas_call$gap  <- round(atlas_call$r - atlas_call$r2, 3)\n",
    "atlas_call$type <- unname(RENAME[atlas_call$best])\n",
    "stopifnot(!any(is.na(atlas_call$type)))\n",
    "cat(\"\\n--- cluster -> atlas type (gap = margin to the runner-up) ---\\n\")\n",
    "print(atlas_call[order(atlas_call$type, -atlas_call$n), ], row.names = FALSE)\n",
    "cat(sprintf(\"\\n%d clusters -> %d cell types\\n\",\n",
    "            nrow(atlas_call), length(unique(atlas_call$type))))\n",
    "cat(sprintf(\"smallest margin: %.3f (cluster %s -> %s, runner-up %s)\\n\",\n",
    "            min(atlas_call$gap), atlas_call$cluster[which.min(atlas_call$gap)],\n",
    "            atlas_call$type[which.min(atlas_call$gap)],\n",
    "            atlas_call$runner_up[which.min(atlas_call$gap)]))\n",
    "write.table(atlas_call, file.path(OUT_TAB, \"atlas_assignment_k20_r0.3.tsv\"),\n",
    "            sep = \"\\t\", quote = FALSE, row.names = FALSE)\n"
   ]
