    "# \u00a73 Metadata\n",
    "qc     <- read.table(file.path(WORKDIR, \"QC\", \"cortex_qc_summary.txt\"),\n",
    "                     header = TRUE, sep = \"\\t\", stringsAsFactors = FALSE, comment.char = \"\")\n",
    "passed <- readLines(file.path(WORKDIR, \"QC\", \"cortex_passed.txt\"))\n",
    "submetadata <- qc[qc$prefix %in% passed, , drop = FALSE]\n",
    "rownames(submetadata) <- submetadata$prefix\n",
    "submetadata$name   <- submetadata$prefix\n",
    "submetadata$cell   <- submetadata$prefix\n",
    "submetadata$sample <- sub(\"_.*\", \"\", submetadata$prefix)\n",
    "cat(\"Cells (QC-passed):\", nrow(submetadata), \"  batches:\\n\"); print(table(submetadata$sample))\n",
    "\n",
    "# --- plate_ID + library_prep_date, merged from the two library sample sheets ---\n",
    "# cortex_qc_summary.txt carries no plate/date, and the old ../metadata.txt covers\n",
    "# only 1143 cells. These spreadsheets cover essentially every cell (1576/1577):\n",
    "#   rep1 (scNH)   key = scNH_c57cortex_L{Lane}_{cell_number}.{barcode, col `...12`}\n",
    "#   rep2 (batch2) key = batch2_sc{N}.{cell_index_sequence}, N from Novogene_ID mc_rep2_{N}\n",
    "suppressPackageStartupMessages(library(readxl))\n",
    "xl1 <- file.path(WORKDIR, \"scNH_micecortex_rep1_demultiplex_w_plateID_libprep_info (1).xlsx\")\n",
    "xl2 <- file.path(WORKDIR, \"samplesheet_sc_micecortex_rep2_05082024_with_plateID_libprep_info (1).xlsx\")\n",
    "r1  <- readxl::read_excel(xl1, sheet = 1)\n",
    "r2  <- rbind(readxl::read_excel(xl2, \"Pool1\")[, c(\"Novogene_ID\", \"cell_index_sequence\", \"plate_ID\", \"Library_prep_date\")],\n",
    "             readxl::read_excel(xl2, \"Pool2\")[, c(\"Novogene_ID\", \"cell_index_sequence\", \"plate_ID\", \"Library_prep_date\")])\n",
    "lib_key   <- c(paste0(\"scNH_c57cortex_L\", r1$Lane, \"_\", r1$cell_number, \".\", r1[[\"...12\"]]),\n",
    "               paste0(\"batch2_sc\", sub(\"mc_rep2_\", \"\", r2$Novogene_ID), \".\", r2$cell_index_sequence))\n",
    "lib_plate <- c(as.character(r1$plate_ID), as.character(r2$plate_ID))\n",
    "lib_dt    <- c(as.character(as.Date(r1$library_prep_date)), as.character(as.Date(r2$Library_prep_date)))\n",
    "keep      <- !duplicated(lib_key)\n",
    "lib_plate <- setNames(lib_plate[keep], lib_key[keep])\n",
    "lib_dt    <- setNames(lib_dt[keep],    lib_key[keep])\n",
    "\n",
    "submetadata$plate_ID          <- unname(lib_plate[rownames(submetadata)])\n",
    "submetadata$library_prep_date <- unname(lib_dt[rownames(submetadata)])\n",
    "# A few cells have no exact (lane, cell_number, barcode) row in the sheets. Within a\n",
    "# group (= cell name minus its barcode) the 8 barcodes split into two FIXED 4-barcode\n",
    "# sets, each belonging to one plate / prep-date:\n",
    "#   set A = ACTTGA/CAGATC/CTTGTA/TAGCTT     set B = ATCACG/CGATGT/GCCAAT/TGACCA\n",
    "# (verified: 209/218 group-plate blocks are exactly one of those two sets; the rest are\n",
    "# strict subsets of them). So a cell with no row inherits the plate/date of the other\n",
    "# cells in its group that share its barcode set -- plate/date is NOT constant across a\n",
    "# whole group, so this must be done per barcode set, not per group.\n",
    "BC_A <- c(\"ACTTGA\", \"CAGATC\", \"CTTGTA\", \"TAGCTT\")\n",
    "BC_B <- c(\"ATCACG\", \"CGATGT\", \"GCCAAT\", \"TGACCA\")\n",
    "bc_set  <- function(b) ifelse(b %in% BC_A, \"A\", ifelse(b %in% BC_B, \"B\", NA_character_))\n",
    "grp_key <- function(x) paste0(sub(\"\\\\.[^.]*$\", \"\", x), \"|\", bc_set(sub(\".*\\\\.\", \"\", x)))\n",
    "mode1   <- function(x) names(sort(table(x), decreasing = TRUE))[1]\n",
    "\n",
    "lib_g      <- grp_key(names(lib_plate))\n",
    "plate_by_g <- tapply(unname(lib_plate), lib_g, mode1)\n",
    "date_by_g  <- tapply(unname(lib_dt),    lib_g, mode1)\n",
    "miss <- is.na(submetadata$library_prep_date)\n",
    "if (any(miss)) {\n",
    "  g <- grp_key(rownames(submetadata)[miss])\n",
    "  submetadata$plate_ID[miss]          <- unname(plate_by_g[g])\n",
    "  submetadata$library_prep_date[miss] <- unname(date_by_g[g])\n",
    "  cat(\"inferred plate/date for\", sum(miss), \"cell(s) from group + barcode set:\",\n",
    "      paste(rownames(submetadata)[miss], collapse = \", \"), \"\\n\")\n",
    "}\n",
    "cat(\"plate/date for\", sum(!is.na(submetadata$library_prep_date)), \"/\", nrow(submetadata),\n",
    "    \"cells |  plates:\", length(unique(na.omit(submetadata$plate_ID))),\n",
    "    \" dates:\", length(unique(na.omit(submetadata$library_prep_date))), \"\\n\")\n"
   ]
