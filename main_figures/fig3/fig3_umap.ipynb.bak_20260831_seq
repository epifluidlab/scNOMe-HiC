   "source": [
    "## \u00a78.7 Joint embedding across modalities (shared UMAP)\n",
    "\n",
    "Per-modality Harmony-corrected embeddings (HCG top-9, Hi-C top-10, GCH\n",
    "top-20 \u2014 matching the locked clustering dims in \u00a74b/\u00a75a/\u00a76c) are z-scored\n",
    "column-wise, concatenated along features, decorrelated via PCA (keeps all\n",
    "9+10+20 = 39 components), then UMAP'd with the same\n",
    "`(n_neighbors = 10, min_dist = 0.2)` settings used by the cell-line\n",
    "notebook so the joint UMAP is comparable across pipelines."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 26,
   "id": "88a606a1",
   "metadata": {
    "vscode": {
     "languageId": "r"
    }
   },
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Cells in all 3 modalities: 1577 \n"
     ]
    },
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Joint concat dims: 1577 39 \n"
     ]
    },
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Joint PCA dims: 1577 39 \n"
     ]
    }
   ],
   "source": [
    "# \u00a78.7a Joint embedding: concat per-modality embeddings -> PCA (keep all 39) -> UMAP\n",
    "hcg_emb <- HCG.harmony[, seq_len(9),  drop = FALSE]   # Harmony, top-9\n",
    "hic_emb <- hic_harmony[, seq_len(10), drop = FALSE]   # Harmony, top-10\n",
    "gch_emb <- gch_harmony[, seq_len(20), drop = FALSE]   # Harmony, top-20\n",
    "\n",
    "shared <- Reduce(intersect, list(rownames(hcg_emb), rownames(hic_emb), rownames(gch_emb)))\n",
    "cat(\"Cells in all 3 modalities:\", length(shared), \"\\n\")\n",
    "hcg_emb <- hcg_emb[shared, , drop = FALSE]\n",
    "hic_emb <- hic_emb[shared, , drop = FALSE]\n",
    "gch_emb <- gch_emb[shared, , drop = FALSE]\n",
    "\n",
    "# Z-score per column, then concatenate features.\n",
    "hcg_std <- scale(hcg_emb)\n",
    "hic_std <- scale(hic_emb)\n",
    "gch_std <- scale(gch_emb)\n",
    "joint_concat <- cbind(hcg_std, hic_std, gch_std)\n",
    "colnames(joint_concat) <- c(paste0(\"HCG\", seq_len(ncol(hcg_std))),\n",
    "                            paste0(\"HiC\", seq_len(ncol(hic_std))),\n",
    "                            paste0(\"GCH\", seq_len(ncol(gch_std))))\n",
    "cat(\"Joint concat dims:\", dim(joint_concat), \"\\n\")\n",
    "\n",
    "# PCA \u2014 keep all components (HCG 9 + HiC 10 + GCH 20 = 39 features, so PCA\n",
    "# here is a decorrelating rotation rather than a dimensionality reduction).\n",
    "n_keep    <- ncol(joint_concat)\n",
    "joint_pca <- prcomp(joint_concat, center = FALSE, scale. = FALSE)$x[, seq_len(n_keep), drop = FALSE]\n",
    "cat(\"Joint PCA dims:\", dim(joint_pca), \"\\n\")\n",
    "\n",
    "# UMAP \u2014 settings mirror the cell-line joint_embedding.ipynb\n",
    "umap_cfg <- umap::umap.defaults\n",
    "umap_cfg$n_neighbors  <- 10\n",
    "umap_cfg$min_dist     <- 0.2\n",
    "umap_cfg$metric       <- \"euclidean\"\n",
    "umap_cfg$random_state <- 42\n",
    "set.seed(42)\n",
    "joint_umap <- umap::umap(joint_pca, config = umap_cfg)\n",
    "rownames(joint_umap$layout) <- shared\n",
    "\n",
    "write.table(joint_pca,         file.path(OUT_TAB, \"joint_embedding.txt\"), sep = \"\\t\", quote = FALSE)\n",
    "write.table(joint_umap$layout, file.path(OUT_TAB, \"joint_umap.txt\"),       sep = \"\\t\", quote = FALSE)\n"
   ]
  },
