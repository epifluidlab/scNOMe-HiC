    "# \u00a74b HCG: Harmony on top-9 SVD, then UMAP + Leiden\n",
    "# Calibrated in exploration: n_pc=9, k=25, resolution=0.6\n",
    "# Harmony removes the per-sample (batch2 vs scNH) shift before clustering;\n",
    "# n_pc=9 is the locked dim from the exploration sweep.\n",
    "meta_h <- submetadata[rownames(HCG.svd), , drop = FALSE]\n",
    "set.seed(42)\n",
    "HCG.harmony <- suppressMessages(suppressWarnings(\n",
    "  RunHarmony(HCG.svd[, 1:9], meta_h, vars_use = \"sample\", verbose = FALSE)))\n",
    "rownames(HCG.harmony) <- rownames(HCG.svd)\n",
    "\n",
    "set.seed(42)\n",
    "HCG.umap <- umap(as.matrix(HCG.harmony))\n",
    "HCG.part <- run_leiden(HCG.harmony, n_pc = 9, k = 25, resolution = 1)\n",
    "names(HCG.part) <- rownames(HCG.harmony)\n",
    "submetadata$hcg_cluster <- NA_integer_\n",
    "submetadata[rownames(HCG.harmony), \"hcg_cluster\"] <- HCG.part\n",
    "cat(\"HCG Leiden:\\n\"); print(table(HCG.part))\n",
    "\n",
    "write.table(HCG.harmony,     file.path(OUT_TAB, \"hcg_embedding_harmony.txt\"), sep = \"\\t\", quote = FALSE)\n",
    "write.table(HCG.umap$layout, file.path(OUT_TAB, \"hcg_umap.txt\"),              sep = \"\\t\", quote = FALSE)\n"
   ]
