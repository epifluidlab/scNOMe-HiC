    "## --- the correlation itself, as a heatmap: clusters x atlas major types ---\n",
    "atlas_order <- c(\"IT-L23\",\"IT-L4\",\"IT-L5\",\"IT-L6\",\"PT-L5\",\"CT-L6\",\"NP-L6\",\"L6b\",\n",
