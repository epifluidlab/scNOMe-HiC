   "source": [
    "# \u00a75a HiC: load + Harmony on top-10 PCs, then UMAP + Leiden\n",
    "# Calibrated in exploration: n_pc=10, k=25, resolution=0.5 (HIC_RES)\n",
    "# Harmony removes the per-sample shift in the hicluster SVD before clustering.\n",
    "hic_h5  <- file.path(WORKDIR, \"06.hiccluster_snakemake\",\n",
    "                     \"hicluster_250kb_embed_dir\",\n",
    "                     \"all_merged.pad1_std1_rp0.5_sqrtvc.svd20.hdf5\")\n",
    "hic_ord <- file.path(WORKDIR, \"06.hiccluster_snakemake\",\n",
    "                     \"hicluster_250kb_chr1_impute_file_list.txt\")\n",
    "hic_mat <- t(h5read(hic_h5, \"/data\"))\n",
    "ind     <- readLines(hic_ord)\n",
    "ind     <- sub(\"_chr\\\\S+\", \"\", sub(\"\\\\S+chr1/\", \"\", ind, perl = TRUE), perl = TRUE)\n",
    "stopifnot(length(ind) == nrow(hic_mat))\n",
    "rownames(hic_mat) <- ind\n",
    "common  <- intersect(rownames(hic_mat), submetadata$name)\n",
    "hic_mat <- hic_mat[common, , drop = FALSE]\n",
    "cat(\"HiC SVD (cells x PCs):\", dim(hic_mat), \"\\n\")\n",
    "\n",
    "meta_h <- submetadata[rownames(hic_mat), , drop = FALSE]\n",
    "set.seed(42)\n",
    "hic_harmony <- suppressMessages(suppressWarnings(\n",
    "  RunHarmony(hic_mat[, 1:10], meta_h, vars_use = \"sample\", verbose = FALSE)))\n",
    "rownames(hic_harmony) <- rownames(hic_mat)\n",
    "\n",
    "set.seed(42)\n",
    "hic_umap <- umap(as.matrix(hic_harmony))\n",
    "hic_part <- run_leiden(hic_harmony, n_pc = 10, k = 25, resolution = 0.5)\n",
    "names(hic_part) <- rownames(hic_harmony)\n",
    "submetadata$hic_cluster <- NA_integer_\n",
    "submetadata[rownames(hic_harmony), \"hic_cluster\"] <- hic_part\n",
    "cat(\"HiC Leiden:\\n\"); print(table(hic_part))\n",
    "\n",
    "write.table(hic_harmony,     file.path(OUT_TAB, \"hic_embedding_harmony.txt\"), sep = \"\\t\", quote = FALSE)\n",
