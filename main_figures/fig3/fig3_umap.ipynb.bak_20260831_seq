   "source": [
    "# \u00a78e Marker panel \u2014 the published markers from the reference atlas.\n",
    "#\n",
    "# Liu et al. 2021 Supplementary Table 7 (\"Cell type annotations\") lists five\n",
    "# marker genes per major type, curated from the literature (Luo 2017, Tasic\n",
    "# 2018, Zeisel 2018, Yao 2020). Using them rather than deriving our own removes\n",
    "# the circularity of a panel selected on the same data it is then shown to fit:\n",
    "# nothing about this gene list was chosen with reference to these cells.\n",
    "#\n",
    "# Each of our ten labels takes the block of the atlas type it corresponds to.\n",
    "# For the merged labels that means choosing which member's block to show, and\n",
    "# PRIMARY records the choice explicitly rather than burying it:\n",
    "#   IT-L5/6 -> IT-L6      (IT-L5 and IT-L6 both map here; IT-L6 scores better)\n",
    "#   CT-L6   -> CT-L6      (not the folded-in NP-L6, whose markers do not transfer)\n",
    "#   Inhib   -> MGE-Pvalb  (of the four inhibitory blocks, the only one that holds)\n",
    "#   PC/EC   -> PC         (rather than EC)\n",
    "# Those four are choices made after seeing the data. They are legitimate for a\n",
    "# descriptive panel but are NOT evidence; the unmerged six types have exactly one\n",
    "# corresponding block each, so nothing is chosen for them.\n",
    "#\n",
    "# Expect an uneven panel. Glial and vascular blocks reproduce almost perfectly;\n",
    "# the excitatory ones are weaker, and IT-L2/3 and IT-L5/6 largely fail. That is\n",
    "# a property of the reference list -- in the CEMBA matrix itself IT-L23 scores\n",
    "# 0/5 and IT-L5/IT-L6 2/5 and 1/5 -- not of this annotation. The printed tally\n",
    "# below is the honest summary; read it rather than the colours, because\n",
    "# scale = \"column\" shows rank within a gene, not effect size.\n",
    "SUPP7 <- file.path(OUT_DIR, \"cemba_ref\", \"supp_table7_marker_genes.tsv\")\n",
    "stopifnot(file.exists(SUPP7))\n",
    "tb7 <- read.delim(SUPP7, stringsAsFactors = FALSE)\n",
    "BLOCKS <- setNames(lapply(tb7$marker_genes,\n",
    "                          function(x) trimws(strsplit(x, \",\")[[1]])), tb7$major_type)\n",
    "PRIMARY <- c(`IT-L2/3` = \"IT-L23\", `IT-L4` = \"IT-L4\", `IT-L5/6` = \"IT-L6\",\n",
    "             `CT-L6` = \"CT-L6\", Inhib = \"MGE-Pvalb\", ODC = \"ODC\", OPC = \"OPC\",\n",
    "             ASC = \"ASC\", MGC = \"MGC\", `PC/EC` = \"PC\")\n",
    "ct_order <- cell_type_levels\n",
    "stopifnot(setequal(names(PRIMARY), ct_order))\n",
    "\n",
    ".mk  <- readRDS(file.path(WORKDIR, \"QC\", \"methylation_matrices\",\n",
    "                          \"HCG_gene_body_counts.rds\"))\n",
    ".cells <- intersect(rownames(submetadata), colnames(.mk$mc))\n",
    ".grp   <- setNames(submetadata[.cells, \"cell_type\"], .cells)\n",
    ".gg    <- rownames(.mk$mc)\n",
    "\n",
    "# read-weighted pseudobulk, each type's own global rate subtracted -- global\n",
    "# gene-body mCG spans ~7 points between types and scale = \"column\" does not\n",
    "# remove it (per-gene centring shifts a gene by a constant)\n",
    ".gmc <- colSums(.mk$mc [, .cells, drop = FALSE])\n",
    ".gcv <- colSums(.mk$cov[, .cells, drop = FALSE])\n",
    ".O <- t(sapply(ct_order, function(t) { ix <- names(.grp)[.grp == t]\n",
    "  rowSums(.mk$mc[.gg, ix, drop = FALSE]) / rowSums(.mk$cov[.gg, ix, drop = FALSE]) -\n",
    "    sum(.gmc[ix]) / sum(.gcv[ix]) }))\n",
    "colnames(.O) <- .gg\n",
    "\n",
    "marker_lists <- lapply(PRIMARY[ct_order], function(b) intersect(BLOCKS[[b]], .gg))\n",
    "names(marker_lists) <- ct_order\n",
    "marker_stats <- do.call(rbind, lapply(ct_order, function(k) {\n",
    "  g <- marker_lists[[k]]; if (!length(g)) return(NULL)\n",
    "  data.frame(cell_type = k, block = unname(PRIMARY[k]), gene = g,\n",
    "             value  = round(.O[k, g], 3),\n",
    "             rank   = sapply(g, function(x) rank(.O[, x])[match(k, ct_order)]),\n",
    "             margin = round(sapply(g, function(x)\n",
    "                        min(.O[setdiff(ct_order, k), x]) - .O[k, x]), 3),\n",
    "             lowest_in = sapply(g, function(x) ct_order[which.min(.O[, x])]),\n",
    "             cov = as.integer(rowSums(.mk$cov[g, names(.grp)[.grp == k], drop = FALSE])))\n",
    "}))\n",
    "rm(.mk); invisible(gc(verbose = FALSE))\n",
    "\n",
    "cat(sprintf(\"published panel: %d genes over %d types\\n\\n\",\n",
    "            length(unlist(marker_lists)), length(marker_lists)))\n",
    "print(marker_stats, row.names = FALSE)\n",
    "cat(\"\\n--- per-type tally: genes where this type IS the most hypomethylated ---\\n\")\n",
    "for (k in ct_order) {\n",
    "  r <- marker_stats[marker_stats$cell_type == k, ]\n",
    "  cat(sprintf(\"  %-9s (%-9s) %d/%d rank 1, mean margin %+.3f\\n\",\n",
    "              k, PRIMARY[[k]], sum(r$rank == 1), nrow(r), mean(r$margin)))\n",
    "}\n",
    "write.csv(marker_stats, file.path(OUT_TAB, \"published_markers_supp7.csv\"), row.names = FALSE)\n",
    "cat(\"\\nwrote tables/published_markers_supp7.csv\\n\")\n"
   ]
