# Only auto-generated junk. Everything in this repo is copied in deliberately,
# so nothing else is filtered -- if a file is here, it is meant to be committed.

__pycache__/
*.pyc
.ipynb_checkpoints/
.Rhistory
.Rproj.user/
.DS_Store

# Internal working logs -- this repo is reviewer-facing.
# They live in ../scNOMeHiC_code_notes/
SESSION_NOTE_*.md

# Downloaded reads and pipeline outputs under data/.
# The folder structure and the READMEs are tracked; nothing else is.
/data/**
!/data/**/
!/data/**/README.md
!/data/**/.gitkeep

# Generated outputs under work/, and the references and tools the user supplies
# under reference/ and software/. The folder structure and the READMEs are
# tracked; nothing else is.
/work/**
!/work/**/
!/work/**/README.md
!/work/**/.gitkeep
/reference/**
!/reference/**/
!/reference/**/README.md
!/reference/**/.gitkeep
/software/**
!/software/**/
!/software/**/README.md
!/software/**/.gitkeep

# Local path settings -- copy paths.yaml to this and edit, to keep your
# machine's layout out of git.
/paths.local.yaml

# Pre-edit notebook snapshots. They belong in ../scNOMeHiC_code_notes/, not here.
*.ipynb.bak_*
